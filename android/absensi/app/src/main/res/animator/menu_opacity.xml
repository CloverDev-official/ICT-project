<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <objectAnimator android:propertyName="alpha" android:valueTo="1"
            android:valueType="floatType" android:duration="100" />
    </item>
    <item android:state_focused="true">
        <objectAnimator android:propertyName="alpha" android:valueTo="1"
            android:valueType="floatType" android:duration="100" />
    </item>
    <item>
        <objectAnimator android:propertyName="alpha" android:valueTo="0.35"
            android:valueType="floatType" android:duration="250" />
    </item>
</selector>
